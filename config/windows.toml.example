# Windows-native starting point. Copy selected values into %USERPROFILE%\.codex\config.toml.
# Keep machine-specific paths, project trust entries, auth, and plugin cache state out of this repo.

model = "gpt-5.5"
model_reasoning_effort = "high"
approval_policy = "on-request"
sandbox_mode = "workspace-write"

[windows]
sandbox = "elevated"

[agents]
max_threads = 6
max_depth = 1
